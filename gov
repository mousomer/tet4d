#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Governance checks are dependency-light. Prefer an explicit governance runtime,
# then the repository environment; use python3 only as the bootstrap for checks
# that diagnose or create the project environment.
if [[ -n "${GOVERNANCE_PYTHON:-}" ]]; then
  GOV_RUNTIME="$GOVERNANCE_PYTHON"
elif [[ -x ".venv/bin/python" ]]; then
  GOV_RUNTIME=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  GOV_RUNTIME="$(command -v python3)"
else
  echo "governance runtime unavailable; set GOVERNANCE_PYTHON or create .venv" >&2
  exit 1
fi

exec "$GOV_RUNTIME" tools/workspace_governance/cli/gov.py "$@"
