{
  "schema_version": 1,
  "resolution_schema_version": 1,
  "lane_order": [
    "baseline",
    "documentation_governance",
    "python",
    "godot",
    "native",
    "deterministic_parity",
    "integration",
    "packaging",
    "platform_macos",
    "platform_ipados",
    "release_acceptance"
  ],
  "always_run_lanes": [
    "baseline"
  ],
  "requirement_to_lanes": {
    "documentation": [
      "documentation_governance"
    ],
    "governance_structure": [
      "documentation_governance"
    ],
    "python": [
      "python"
    ],
    "godot": [
      "godot"
    ],
    "native": [
      "native"
    ],
    "deterministic": [
      "deterministic_parity"
    ],
    "parity_or_conformance": [
      "deterministic_parity"
    ],
    "integration": [
      "integration"
    ],
    "human_visual": [],
    "packaging": [
      "packaging"
    ],
    "platform": [],
    "platform_macos": [
      "platform_macos"
    ],
    "platform_windows": [],
    "platform_linux": [],
    "platform_android": [],
    "platform_ipados": [
      "platform_ipados"
    ],
    "release_acceptance": [
      "release_acceptance"
    ]
  },
  "manual_requirements": [
    "human_visual",
    "platform_windows",
    "platform_linux",
    "platform_android"
  ],
  "abstract_requirements": {
    "platform": [
      "platform_macos",
      "platform_windows",
      "platform_linux",
      "platform_android",
      "platform_ipados"
    ]
  },
  "platform_evidence": {
    "schema_version": 1,
    "description": "Platform verification carries explicit platform identity. The abstract family requirement never stands alone and never resolves to a single default platform.",
    "abstract_requirement": "platform",
    "platform_requirement_ids": {
      "macos": "platform_macos",
      "windows": "platform_windows",
      "linux": "platform_linux",
      "android": "platform_android",
      "ipados": "platform_ipados"
    },
    "hosted_lanes": {
      "platform_macos": {
        "lane": "platform_macos",
        "platform_id": "macos",
        "workflow_job": "platform-macos",
        "packaging_consumer": "godot_game_macos",
        "canonical_command": "macos_release_export",
        "build_entrypoint": "packaging/godot/build_macos.sh"
      },
      "platform_ipados": {
        "lane": "platform_ipados",
        "platform_id": "ipados",
        "workflow_job": "platform-ipados",
        "packaging_consumer": "legacy_designer_ipados",
        "canonical_command": "ipados_release_export",
        "build_entrypoint": "packaging/godot/build_ipados.sh"
      }
    },
    "unhosted_platform_requirements": [
      "platform_windows",
      "platform_linux",
      "platform_android"
    ]
  },
  "full_repository_gate_lanes": [
    "baseline",
    "documentation_governance",
    "python",
    "godot",
    "native",
    "deterministic_parity",
    "integration",
    "packaging",
    "platform_macos",
    "platform_ipados",
    "release_acceptance"
  ],
  "path_classification": {
    "schema_version": 1,
    "unknown_path_policy": "full_repository_gate",
    "cross_layer_requirements": [
      "python",
      "godot",
      "native",
      "packaging"
    ],
    "cross_layer_verification_requirement": "integration",
    "rules": [
      {
        "id": "ci_and_shared_infrastructure",
        "patterns": [
          ".github/workflows/**",
          "scripts/**",
          "pyproject.toml",
          "setup.cfg",
          "requirements*.txt",
          ".gitignore",
          ".gitattributes"
        ],
        "requirements": [
          "governance_structure",
          "python"
        ],
        "requires_full_repository_gate": true
      },
      {
        "id": "codex_ci_selection_infrastructure",
        "patterns": [
          "config/project/codex_ci_lanes.json",
          "tools/governance/classify_codex_ci_paths.py",
          "tools/governance/select_codex_ci_lanes.py",
          "tests/unit/governance/test_classify_codex_ci_paths.py",
          "tests/unit/governance/test_select_codex_ci_lanes.py",
          "tests/unit/governance/test_platform_ci_routing.py"
        ],
        "requirements": [
          "governance_structure",
          "python"
        ],
        "requires_full_repository_gate": true
      },
      {
        "id": "governance_documents",
        "patterns": [
          "AGENTS.md",
          "**/AGENTS.md",
          "docs/governance/**",
          "docs/architecture/authority_map.md",
          "docs/architecture/authority_transfer_protocol.md"
        ],
        "requirements": [
          "documentation",
          "governance_structure"
        ]
      },
      {
        "id": "governance_configuration",
        "patterns": [
          "config/project/**"
        ],
        "requirements": [
          "governance_structure"
        ]
      },
      {
        "id": "governance_python",
        "patterns": [
          "tools/governance/**",
          "tests/unit/governance/**"
        ],
        "requirements": [
          "governance_structure",
          "python"
        ]
      },
      {
        "id": "documentation",
        "patterns": [
          "*.md",
          "**/*.md",
          "LICENSE*"
        ],
        "requirements": [
          "documentation"
        ]
      },
      {
        "id": "python",
        "patterns": [
          "front.py",
          "cli/**",
          "src/**/*.py",
          "tests/*.py",
          "tests/**/*.py",
          "tools/**/*.py"
        ],
        "requirements": [
          "python"
        ]
      },
      {
        "id": "deterministic_semantics",
        "patterns": [
          "config/gameplay/**",
          "config/topology/**",
          "src/tet4d/engine/gameplay/**",
          "src/tet4d/engine/**/*replay*",
          "src/tet4d/engine/**/*topology*",
          "src/tet4d/engine/**/*trace*",
          "tests/*replay*",
          "tests/*topology*",
          "tests/*trace*",
          "tests/**/*replay*",
          "tests/**/*topology*",
          "tests/**/*trace*"
        ],
        "requirements": [
          "python",
          "deterministic"
        ]
      },
      {
        "id": "runtime_configuration",
        "patterns": [
          "config/**"
        ],
        "requirements": [
          "python"
        ]
      },
      {
        "id": "parity_and_migration",
        "patterns": [
          "tools/migration/**",
          "tools/parity/**",
          "tests/unit/migration/**",
          "tests/fixtures/parity/**"
        ],
        "requirements": [
          "python",
          "parity_or_conformance"
        ]
      },
      {
        "id": "godot",
        "patterns": [
          "godot/**"
        ],
        "requirements": [
          "godot"
        ]
      },
      {
        "id": "native",
        "patterns": [
          "native/**"
        ],
        "requirements": [
          "native"
        ]
      },
      {
        "id": "integration_tests",
        "patterns": [
          "tests/integration/**",
          "tests/e2e/**"
        ],
        "requirements": [
          "integration"
        ]
      },
      {
        "id": "packaging",
        "patterns": [
          "packaging/**"
        ],
        "requirements": [
          "packaging"
        ]
      },
      {
        "id": "packaging_macos_platform",
        "patterns": [
          "packaging/godot/*macos*"
        ],
        "requirements": [
          "packaging",
          "platform",
          "platform_macos"
        ]
      },
      {
        "id": "packaging_windows_platform",
        "patterns": [
          "packaging/godot/*windows*",
          "tests/test_windows_godot_package_validator.py"
        ],
        "requirements": [
          "packaging",
          "platform",
          "platform_windows"
        ]
      },
      {
        "id": "packaging_android_platform",
        "patterns": [
          "packaging/godot/*android*",
          "tests/test_android_godot_export_validator.py"
        ],
        "requirements": [
          "packaging",
          "platform",
          "platform_android"
        ]
      },
      {
        "id": "packaging_ipados_platform",
        "patterns": [
          "packaging/godot/*ipados*",
          "tests/test_ipados_native_packaging.py",
          "tests/test_ipados_xcode_project_validator.py"
        ],
        "requirements": [
          "packaging",
          "platform",
          "platform_ipados"
        ]
      },
      {
        "id": "packaging_godot_export_reader",
        "patterns": [
          "packaging/godot/godot_pack.py"
        ],
        "requirements": [
          "packaging",
          "platform",
          "platform_android",
          "platform_ipados"
        ]
      },
      {
        "id": "packaging_godot_product_profile_staging",
        "patterns": [
          "packaging/godot/stage_product_profile.py"
        ],
        "requirements": [
          "packaging",
          "platform",
          "platform_macos",
          "platform_windows",
          "platform_android",
          "platform_ipados"
        ]
      }
    ]
  }
}
