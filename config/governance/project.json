        "mode": "STRUCTURAL_CHANGE",
        "priority": 200,
        "routes": [
          "packaging_and_release"
        ]
      },
      {
        "id": "product-planning-change",
        "match_all": [
          "product",
          "planning"
        ],
        "mode": "FEATURE",
        "priority": 200,
        "routes": [
          "product_planning"
        ]
      },
      {
        "id": "topology-explorer-change",
        "match_all": [
          "topology",
          "explorer"
        ],
        "mode": "FEATURE",
        "priority": 250,
        "routes": [
          "topology_and_explorer"
        ]
      },
      {
        "id": "live-4d-rosette-fix",
        "match_all": [
          "fix",
          "live",
          "4d",
          "rosette"
        ],
        "mode": "LOCAL_FIX",
        "priority": 350,
        "routes": [
          "godot_product_shell"
        ]
      }
