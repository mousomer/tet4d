{
  "schema_version": 1,
  "project": {"id": "tet4d", "name": "Tet4D"},
  "authorities": [
    {"authority_id": "engineering", "authority_type": "human", "scope": "engineering-practice", "source": "docs/governance/ENGINEERING.md", "exclusive": true},
    {"authority_id": "verification", "authority_type": "human", "scope": "verification-evidence", "source": "docs/governance/VERIFICATION.md", "exclusive": true},
    {"authority_id": "change-governance", "authority_type": "human", "scope": "change-governance", "source": "docs/governance/CHANGE_GOVERNANCE.md", "exclusive": true},
    {"authority_id": "security-sanitation", "authority_type": "human", "scope": "security-sanitation", "source": "docs/governance/SECURITY_AND_SANITATION.md", "exclusive": true},
    {"authority_id": "config-generated-data", "authority_type": "human", "scope": "config-generated-data", "source": "docs/governance/CONFIG_AND_GENERATED_DATA.md", "exclusive": true},
    {"authority_id": "architecture", "authority_type": "human", "scope": "architecture", "source": "docs/ARCHITECTURE_CONTRACT.md", "exclusive": true},
    {"authority_id": "subsystem-ownership", "authority_type": "human", "scope": "subsystem-ownership", "source": "docs/architecture/authority_map.md", "exclusive": true},
    {"authority_id": "godot-runtime", "authority_type": "human", "scope": "godot-product-shell", "source": "docs/architecture/authority_map.md", "exclusive": true},
    {"authority_id": "product-requirements", "authority_type": "human", "scope": "product-behaviour", "source": "docs/rds/", "exclusive": true},
    {"authority_id": "legacy-policy-pack", "authority_type": "compatibility", "scope": "unmigrated-machine-policy", "source": "config/project/policy_pack.json", "exclusive": true},
    {"authority_id": "python-project-metadata", "authority_type": "project_metadata", "scope": "python-environment-contract", "source": "pyproject.toml", "exclusive": true}
  ],
  "routes": {
    "governance_and_tooling": {"authority_refs": ["engineering", "verification", "change-governance", "security-sanitation", "config-generated-data", "architecture", "legacy-policy-pack"]},
    "python_reference_engine": {"authority_refs": ["engineering", "verification", "architecture", "subsystem-ownership", "product-requirements"]},
    "godot_product_shell": {"authority_refs": ["verification", "architecture", "godot-runtime", "subsystem-ownership", "product-requirements"], "environment_tools": ["godot"]},
    "native_deterministic_core": {"authority_refs": ["verification", "architecture", "subsystem-ownership", "product-requirements"]},
    "packaging_and_release": {"authority_refs": ["verification", "change-governance", "security-sanitation", "legacy-policy-pack"]}
  },
  "verification": {
    "canonical": {"authority_ref": "legacy-policy-pack", "json_pointer": "/governance/verification_command"},
    "full": {"authority_ref": "legacy-policy-pack", "json_pointer": "/governance/godot_toolchain/canonical_commands/full_repository"},
    "targeted": "./scripts/verify_focus.sh",
    "rule": "task + authority + actual diff + risk"
  },
  "execution": {
    "default_mode": "FEATURE",
    "profiles": {
      "LOCAL_FIX": {"exploration": ["reproduce", "owning-source", "direct-tests"], "routes": ["python_reference_engine"], "final_evidence_rule": "resolved-from-diff-authority-risk"},
      "FEATURE": {"exploration": ["owner", "neighboring-contracts", "bounded-architecture-search"], "routes": ["python_reference_engine"], "final_evidence_rule": "resolved-from-diff-authority-risk"},
      "STRUCTURAL_CHANGE": {"exploration": ["authority-review", "routing-review", "repository-impact", "generated-surfaces"], "routes": ["governance_and_tooling"], "final_evidence_rule": "resolved-from-diff-authority-risk"}
    },
    "representative_scenarios": [
      {"id": "small-godot-ui-defect", "match_all": ["small", "godot", "defect"], "mode": "LOCAL_FIX", "routes": ["godot_product_shell"]},
      {"id": "small-python-defect", "match_all": ["small", "python", "defect"], "mode": "LOCAL_FIX", "routes": ["python_reference_engine"]},
      {"id": "moderate-feature", "match_all": ["moderate", "feature"], "mode": "FEATURE", "routes": ["python_reference_engine"]},
      {"id": "cross-layer-change", "match_all": ["cross-layer"], "mode": "STRUCTURAL_CHANGE", "routes": ["python_reference_engine", "godot_product_shell", "native_deterministic_core"]},
      {"id": "governance-change", "match_all": ["governance", "change"], "mode": "STRUCTURAL_CHANGE", "routes": ["governance_and_tooling"]},
      {"id": "packaging-release-change", "match_all": ["packaging", "release"], "mode": "STRUCTURAL_CHANGE", "routes": ["packaging_and_release"]},
      {"id": "live-4d-rosette-fix", "match_all": ["fix", "live", "4d", "rosette"], "mode": "LOCAL_FIX", "routes": ["godot_product_shell"]}
    ]
  },
  "generated_surfaces": [],
  "environment": {
    "python_requires": {"authority_ref": "python-project-metadata", "source_field": "project.requires-python"},
    "dependency_authority": {"authority_ref": "python-project-metadata", "source": "pyproject.toml"},
    "preferred": ".venv/bin/python",
    "interpreter_override": "TET4D_PYTHON",
    "package_import": "tet4d",
    "editable_source": "src/tet4d",
    "critical_packages": ["tet4d", "pytest", "ruff"],
    "route_tools": {
      "godot": {"override": "GODOT_BIN", "candidates": ["godot"], "version_args": ["--version"]}
    }
  },
  "sanitation": {
    "secret_scanner": "tools/governance/scan_secrets.py",
    "repository_check": "scripts/check_git_sanitation_repo.sh",
    "bounded_diagnostics": 50
  },
  "compatibility": {
    "facade": "config/project/policy_pack.json",
    "status": "authoritative-for-unmigrated-fields",
    "rule": "no project.json field duplicates an unmigrated facade fact as canonical"
  }
}
