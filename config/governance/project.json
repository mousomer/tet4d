{
  "schema_version": 1,
  "project": {"id": "tet4d", "name": "Tet4D"},
  "authorities": [
    {"authority_id": "engineering", "authority_type": "human", "scope": "engineering-practice", "source": "docs/governance/ENGINEERING.md", "exclusive": true, "canonical_governance": true, "legacy_key": "engineering_governance", "source_type": "file"},
    {"authority_id": "verification", "authority_type": "human", "scope": "verification-evidence", "source": "docs/governance/VERIFICATION.md", "exclusive": true, "canonical_governance": true, "legacy_key": "verification_governance", "source_type": "file"},
    {"authority_id": "change-governance", "authority_type": "human", "scope": "change-governance", "source": "docs/governance/CHANGE_GOVERNANCE.md", "exclusive": true, "canonical_governance": true, "legacy_key": "change_governance", "source_type": "file"},
    {"authority_id": "security-sanitation", "authority_type": "human", "scope": "security-sanitation", "source": "docs/governance/SECURITY_AND_SANITATION.md", "exclusive": true, "canonical_governance": true, "legacy_key": "security_and_sanitation_governance", "source_type": "file"},
    {"authority_id": "config-generated-data", "authority_type": "human", "scope": "config-generated-data", "source": "docs/governance/CONFIG_AND_GENERATED_DATA.md", "exclusive": true, "canonical_governance": true, "legacy_key": "config_and_generated_data_governance", "source_type": "file"},
    {"authority_id": "native-and-platform", "authority_type": "human", "scope": "native-platform-policy", "source": "docs/governance/NATIVE_AND_PLATFORM.md", "exclusive": true, "canonical_governance": true, "legacy_key": "native_and_platform_governance", "source_type": "file"},
    {"authority_id": "authority-transfer", "authority_type": "human", "scope": "authority-transfer-establishment", "source": "docs/architecture/authority_transfer_protocol.md", "exclusive": true, "canonical_governance": false, "legacy_key": "authority_transfer_and_establishment_protocol", "source_type": "file"},
    {"authority_id": "architecture", "authority_type": "human", "scope": "architecture", "source": "docs/ARCHITECTURE_CONTRACT.md", "exclusive": true, "canonical_governance": false, "legacy_key": "architecture_contract", "source_type": "file"},
    {"authority_id": "subsystem-ownership", "authority_type": "human", "scope": "subsystem-ownership", "source": "docs/architecture/authority_map.md", "exclusive": true, "canonical_governance": false, "legacy_key": "subsystem_authority_map", "source_type": "file"},
    {"authority_id": "godot-runtime", "authority_type": "alias", "scope": "godot-product-shell", "source": "docs/architecture/authority_map.md", "exclusive": false, "canonical_governance": false, "alias_of": "subsystem-ownership", "source_type": "alias"},
    {"authority_id": "product-requirements", "authority_type": "human", "scope": "product-behaviour", "source": "docs/rds/", "exclusive": true, "canonical_governance": false, "legacy_key": "product_requirements_root", "source_type": "directory"},
    {"authority_id": "professional-product-programme", "authority_type": "human", "scope": "product-programme", "source": "docs/plans/professional_godot_game_programme.md", "exclusive": true, "canonical_governance": false, "legacy_key": "professional_product_programme", "source_type": "file"},
    {"authority_id": "open-work-backlog", "authority_type": "human", "scope": "open-work", "source": "docs/BACKLOG.md", "exclusive": true, "canonical_governance": false, "legacy_key": "open_work_backlog", "source_type": "file"},
    {"authority_id": "topology-current-authority", "authority_type": "human", "scope": "topology-current-state", "source": "docs/architecture/topology_playground_current_authority.md", "exclusive": true, "canonical_governance": false, "legacy_key": "topology_current_authority", "source_type": "file"},
    {"authority_id": "legacy-policy-pack", "authority_type": "compatibility", "scope": "unmigrated-machine-policy", "source": "config/project/policy_pack.json", "exclusive": true, "canonical_governance": false, "legacy_key": "machine_authority", "source_type": "file"},
    {"authority_id": "python-project-metadata", "authority_type": "project_metadata", "scope": "python-environment-contract", "source": "pyproject.toml", "exclusive": true, "canonical_governance": false, "source_type": "file"}
  ],
  "routes": {
    "product_planning": {
      "authority_refs": ["professional-product-programme", "product-requirements", "open-work-backlog", "change-governance", "verification"],
      "dispatch_paths": [],
      "typical_verification_requirements": ["documentation"]
    },
    "python_reference_engine": {
      "authority_refs": ["architecture", "product-requirements", "subsystem-ownership", "engineering", "verification", "config-generated-data"],
      "dispatch_paths": [],
      "typical_verification_requirements": ["python", "deterministic"]
    },
    "godot_product_shell": {
      "authority_refs": ["product-requirements", "subsystem-ownership", "native-and-platform", "verification", "config-generated-data"],
      "dispatch_paths": ["godot/AGENTS.md"],
      "typical_verification_requirements": ["godot"],
      "environment_tools": ["godot"]
    },
    "native_deterministic_core": {
      "authority_refs": ["subsystem-ownership", "authority-transfer", "native-and-platform", "verification", "security-sanitation", "engineering"],
      "dispatch_paths": ["native/AGENTS.md"],
      "typical_verification_requirements": ["native", "deterministic"]
    },
    "topology_and_explorer": {
      "authority_refs": ["topology-current-authority", "product-requirements", "subsystem-ownership", "engineering", "native-and-platform", "verification"],
      "dispatch_paths": [],
      "typical_verification_requirements": ["deterministic"]
    },
    "governance_and_tooling": {
      "authority_refs": ["legacy-policy-pack", "change-governance", "verification", "engineering"],
      "dispatch_paths": [],
      "typical_verification_requirements": ["governance_structure"]
    },
    "packaging_and_release": {
      "authority_refs": ["native-and-platform", "security-sanitation", "verification", "change-governance"],
      "dispatch_paths": ["docs/rds/RDS_PACKAGING.md", "docs/RELEASE_CHECKLIST.md"],
      "typical_verification_requirements": ["packaging", "platform"]
    }
  },
  "verification": {
    "canonical": {"authority_ref": "legacy-policy-pack", "json_pointer": "/governance/verification_command"},
    "full": {"authority_ref": "legacy-policy-pack", "json_pointer": "/governance/godot_toolchain/canonical_commands/full_repository"},
    "targeted": "./scripts/verify_focus.sh",
    "rule": "task + authority + actual diff + risk"
  },
  "execution": {
    "default_mode": "FEATURE",
    "profiles": {
      "LOCAL_FIX": {
        "exploration": ["reproduce", "owning-source", "direct-tests"],
        "routes": ["python_reference_engine"],
        "final_evidence_rule": "resolved-from-diff-authority-risk"
      },
      "FEATURE": {
        "exploration": ["owner", "neighboring-contracts", "bounded-architecture-search"],
        "routes": ["python_reference_engine"],
        "final_evidence_rule": "resolved-from-diff-authority-risk"
      },
      "STRUCTURAL_CHANGE": {
        "exploration": ["authority-review", "routing-review", "repository-impact", "generated-surfaces"],
        "routes": ["governance_and_tooling"],
        "final_evidence_rule": "resolved-from-diff-authority-risk"
      }
    },
    "representative_scenarios": [
      {
        "id": "small-godot-ui-defect",
        "match_all": ["small", "godot", "defect"],
        "mode": "LOCAL_FIX",
        "routes": ["godot_product_shell"]
      },
      {
        "id": "small-python-defect",
        "match_all": ["small", "python", "defect"],
        "mode": "LOCAL_FIX",
        "routes": ["python_reference_engine"]
      },
      {
        "id": "moderate-feature",
        "match_all": ["moderate", "feature"],
        "mode": "FEATURE",
        "routes": ["python_reference_engine"]
      },
      {
        "id": "cross-layer-change",
        "match_all": ["cross-layer"],
        "mode": "STRUCTURAL_CHANGE",
        "routes": ["python_reference_engine", "godot_product_shell", "native_deterministic_core"]
      },
      {
        "id": "governance-change",
        "match_all": ["governance", "change"],
        "mode": "STRUCTURAL_CHANGE",
        "routes": ["governance_and_tooling"]
      },
      {
        "id": "packaging-release-change",
        "match_all": ["packaging", "release"],
        "mode": "STRUCTURAL_CHANGE",
        "routes": ["packaging_and_release"]
      },
      {
        "id": "product-planning-change",
        "match_all": ["product", "planning"],
        "mode": "FEATURE",
        "routes": ["product_planning"]
      },
      {
        "id": "topology-explorer-change",
        "match_all": ["topology", "explorer"],
        "mode": "FEATURE",
        "routes": ["topology_and_explorer"]
      },
      {
        "id": "live-4d-rosette-fix",
        "match_all": ["fix", "live", "4d", "rosette"],
        "mode": "LOCAL_FIX",
        "routes": ["godot_product_shell"]
      }
    ]
  },
  "generated_surfaces": [
    {"surface_id": "legacy-route-facade", "kind": "compatibility_facade", "source": "config/governance/project.json#/routes", "target": "config/project/policy_pack.json#/codex_routing/routes", "transform": "authority-legacy-key-route-v1"}
  ],
  "environment": {
    "python_requires": {"authority_ref": "python-project-metadata", "source_field": "project.requires-python"},
    "dependency_authority": {"authority_ref": "python-project-metadata", "source": "pyproject.toml"},
    "preferred": ".venv/bin/python",
    "interpreter_override": "TET4D_PYTHON",
    "execution_mode": {
      "override": "TET4D_ENVIRONMENT_MODE",
      "default": "installed"
    },
    "package_import": "tet4d",
    "editable_source": "src/tet4d",
    "critical_packages": ["tet4d", "pytest", "ruff", "packaging"],
    "route_tools": {
      "godot": {
        "override": "GODOT_BIN",
        "candidates": ["godot"],
        "version_args": ["--version"]
      }
    }
  },
  "sanitation": {"secret_scanner": "tools/governance/scan_secrets.py", "repository_check": "scripts/check_git_sanitation_repo.sh", "bounded_diagnostics": 50},
  "canonical_owner_set": {"authority_ref": "legacy-policy-pack", "json_pointer": "/authority_model/canonical_human_owners"}
}
