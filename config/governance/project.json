    "json_pointer": "/authority_model/canonical_human_owners"
  },
  "environment": {
    "critical_packages": [
      "tet4d",
      "pytest",
      "ruff",
      "packaging"
    ],
    "dependency_authority": {
      "authority_ref": "python-project-metadata",
      "source": "pyproject.toml"
    },
    "editable_source": "src/tet4d",
    "execution_mode": {
      "default": "installed",
      "override": "TET4D_ENVIRONMENT_MODE"
    },
    "interpreter_override": "TET4D_PYTHON",
    "package_import": "tet4d",
    "preferred": ".venv/bin/python",
    "python_requires": {
      "authority_ref": "python-project-metadata",
      "source_field": "project.requires-python"
    },
    "route_tools": {
      "godot": {
        "candidates": [
          "godot"
        ],
        "override": "GODOT_BIN",
        "version_args": [
          "--version"
        ]
      }
    }
  },
  "execution": {
    "default_mode": "FEATURE",
    "profiles": {
      "FEATURE": {
        "exploration": [
          "owner",
          "neighboring-contracts",
          "bounded-architecture-search"
        ],
        "final_evidence_rule": "resolved-from-diff-authority-risk",
        "routes": [
          "godot_product_shell"
        ]
      },
      "LOCAL_FIX": {
        "exploration": [
          "reproduce",
          "owning-source",
          "direct-tests"
        ],
        "final_evidence_rule": "resolved-from-diff-authority-risk",
        "routes": [
          "godot_product_shell"
        ]
      },
      "STRUCTURAL_CHANGE": {
        "exploration": [
          "authority-review",
          "routing-review",
          "repository-impact",
          "generated-surfaces"
        ],
        "final_evidence_rule": "resolved-from-diff-authority-risk",
        "routes": [
          "governance_and_tooling"
        ]
      }
    },
    "representative_scenarios": [
      {
        "id": "small-godot-ui-defect",
        "match_all": [
          "small",
          "godot",
          "defect"
        ],
        "mode": "LOCAL_FIX",
        "priority": 300,
        "routes": [
          "godot_product_shell"
        ]
      },
      {
        "id": "godot-presentation-feature",
        "match_all": [
          "godot",
          "presentation feature"
