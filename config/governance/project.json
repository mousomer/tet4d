      {
        "id": "python-work",
        "match_all": [
          "python"
        ],
        "mode": "FEATURE",
        "priority": 100,
        "routes": [
          "python_reference_engine"
        ]
      },
      {
        "id": "moderate-feature",
        "match_all": [
          "moderate",
          "feature"
        ],
        "mode": "FEATURE",
        "priority": 100,
        "routes": [
          "python_reference_engine"
        ]
      },
      {
        "id": "cross-layer-change",
        "match_all": [
          "cross-layer"
        ],
        "mode": "STRUCTURAL_CHANGE",
        "priority": 400,
        "routes": [
          "python_reference_engine",
          "godot_product_shell",
          "native_deterministic_core"
        ]
      },
      {
        "id": "governance-change",
        "match_all": [
          "governance",
          "change"
        ],
        "mode": "STRUCTURAL_CHANGE",
        "priority": 100,
        "routes": [
          "governance_and_tooling"
        ]
      },
      {
        "id": "ci-platform-routing-repair",
        "match_all": [
          "ci classification",
          "platform routing"
        ],
        "mode": "STRUCTURAL_CHANGE",
        "priority": 350,
        "routes": [
          "governance_and_tooling",
          "packaging_and_release"
        ]
      },
      {
        "id": "product-platform-routing-repair",
        "match_all": [
          "product-platform routing",
          "repair"
        ],
        "mode": "STRUCTURAL_CHANGE",
        "priority": 300,
        "routes": [
          "governance_and_tooling",
