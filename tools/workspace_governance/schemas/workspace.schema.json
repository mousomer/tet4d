{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "governance_pack", "projects", "relationships", "defaults"],
  "properties": {
    "schema_version": {"const": 1, "x-governance-use": "validation-only"},
    "workspace_id": {"type": "string", "minLength": 1, "x-governance-use": "consumed"},
    "governance_pack": {"type": "object", "additionalProperties": false, "required": ["required_schema", "lock"], "x-governance-use": "consumed", "properties": {
      "required_schema": {"type": "integer", "minimum": 1, "x-governance-use": "consumed"},
      "lock": {"type": "string", "minLength": 1, "x-governance-use": "consumed"}
    }},
    "projects": {"type": "array", "minItems": 1, "x-governance-use": "consumed", "items": {"type": "object", "additionalProperties": false, "required": ["id", "repository", "manifest"], "properties": {
      "id": {"type": "string", "minLength": 1, "x-governance-use": "consumed"},
      "repository": {"type": "string", "minLength": 1, "x-governance-use": "consumed"},
      "manifest": {"type": "string", "minLength": 1, "x-governance-use": "consumed"}
    }}},
    "relationships": {"type": "array", "maxItems": 0, "x-governance-use": "reserved-for-future-use", "items": {"type": "object"}},
    "defaults": {"type": "object", "additionalProperties": false, "required": ["project"], "x-governance-use": "consumed", "properties": {
      "project": {"type": "string", "minLength": 1, "x-governance-use": "consumed"}
    }}
  }
}
