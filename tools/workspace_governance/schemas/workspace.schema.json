{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "governance_pack", "projects", "relationships", "defaults"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "governance_pack": {
      "type": "object", "additionalProperties": false,
      "required": ["required_schema", "lock"],
      "properties": {"required_schema": {"type": "integer"}, "lock": {"type": "string"}}
    },
    "projects": {"type": "array"},
    "relationships": {"type": "array"},
    "defaults": {"type": "object"}
  }
}
