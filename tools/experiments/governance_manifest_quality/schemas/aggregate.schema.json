{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tet4d.local/experiments/governance-manifest-quality/aggregate-v1.schema.json",
  "title": "Stage C1 historical-corpus aggregate",
  "type": "object",
  "required": [
    "schema_version",
    "discovered",
    "successfully_measured",
    "incomplete_measurements",
    "incomplete_reason_counts",
    "rejected_during_ingestion",
    "excluded",
    "excluded_after_normalization",
    "unsupported_format",
    "missing_required_provenance",
    "other_unprocessed",
    "status_reasons",
    "status_reconciled",
    "governance_materialized_bytes",
    "governance_known_materialized_bytes",
    "governance_unique_materialized_bytes",
    "governance_repeated_materialized_bytes",
    "non_governance_materialized_bytes",
    "read_modes",
    "governance_read_events",
    "governance_mutation_events",
    "governance_mutation_trajectories",
    "governance_file_activity",
    "non_governance_known_materialized_bytes",
    "tool_calls",
    "shell_commands",
    "searches",
    "test_invocations",
    "failed_commands",
    "repeated_failed_commands",
    "conspicuous_outliers",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "discovered": {"type": "integer", "minimum": 0},
    "successfully_measured": {"type": "integer", "minimum": 0},
    "incomplete_measurements": {"type": "integer", "minimum": 0},
    "incomplete_reason_counts": {"type": "object"},
    "rejected_during_ingestion": {"type": "integer", "minimum": 0},
    "excluded": {"type": "integer", "minimum": 0},
    "excluded_after_normalization": {"type": "integer", "minimum": 0},
    "unsupported_format": {"type": "integer", "minimum": 0},
    "missing_required_provenance": {"type": "integer", "minimum": 0},
    "other_unprocessed": {"type": "integer", "minimum": 0},
    "status_reasons": {"type": "object"},
    "status_reconciled": {"const": true},
    "governance_materialized_bytes": {"type": "object"},
    "governance_known_materialized_bytes": {"type": "object"},
    "governance_unique_materialized_bytes": {"type": "object"},
    "governance_repeated_materialized_bytes": {"type": "object"},
    "non_governance_materialized_bytes": {"type": "object"},
    "read_modes": {"type": "object"},
    "governance_read_events": {"type": "integer", "minimum": 0},
    "governance_mutation_events": {"type": "integer", "minimum": 0},
    "governance_mutation_trajectories": {"type": "integer", "minimum": 0},
    "governance_file_activity": {"type": "array"},
    "non_governance_known_materialized_bytes": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "shell_commands": {"type": "integer", "minimum": 0},
    "searches": {"type": "integer", "minimum": 0},
    "test_invocations": {"type": "integer", "minimum": 0},
    "failed_commands": {"type": "integer", "minimum": 0},
    "repeated_failed_commands": {"type": "integer", "minimum": 0},
    "conspicuous_outliers": {"type": "array"},
    "interpretation": {"const": "observational_baseline_only"}
  }
}
