{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/workspace_governance/hooks/no_polling.sh claude || exit 2",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/workspace_governance/hooks/no_polling.sh claude prompt || exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
